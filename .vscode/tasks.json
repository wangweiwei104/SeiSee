		{
			"label": "Build all",
			"type": "process",
			"command": "make",
			"args": ["-j8"],
			"options": {"cwd": "${workspaceFolder}"},
			"linux": {
				"options": {
					"cwd": "${workspaceFolder}",
					"env": {
						"PATH": "/home/ww/Qt/5.15.2/gcc_64/bin:${env:PATH}",
						"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}"
					}
				}
			},
			"windows": {
				"command": "C:/Qt/Tools/mingw810_64/bin/mingw32-make.exe",
				"options": {
					"cwd": "${workspaceFolder}",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"dependsOn": "qmake",
			"dependsOrder": "sequence",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "Clean build outputs",
			"type": "process",
			"command": "bash",
			"args": [
				"-lc",
				"find . -type f \\( -name 'Makefile*' -o -name '.qmake.stash' -o -name '*.Debug' -o -name '*.Release' -o -name '*.o' -o -name '*.a' \\) -delete && find . -depth -type d \\( -name debug -o -name release \\) -exec rm -rf -- {} +"
			],
			"options": {"cwd": "${workspaceFolder}"},
			"windows": {
				"command": "powershell.exe",
				"args": [
					"-NoProfile",
					"-Command",
					"Get-ChildItem -Path . -File -Recurse -Force | Where-Object { $_.Name -like 'Makefile*' -or $_.Name -eq '.qmake.stash' -or $_.Extension -in @('.Debug','.Release','.o','.a') } | Remove-Item -Force; Get-ChildItem -Path . -Directory -Recurse -Force | Where-Object { $_.Name -in @('debug','release') } | Sort-Object { $_.FullName.Length } -Descending | Remove-Item -Recurse -Force"
				]
			},
			"problemMatcher": "$gcc"
		},
		{
