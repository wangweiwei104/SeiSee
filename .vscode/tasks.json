{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "qmake",
			"type": "process",
			"command": "/home/ww/Qt/5.15.2/gcc_64/bin/qmake",
			"args": ["GxApps.pro", "-r", "CONFIG+=release"],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PATH": "/home/ww/Qt/5.15.2/gcc_64/bin:${env:PATH}",
					"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}"
				}
			},
			"linux": {
				"command": "bash",
				"args": ["-c", "mkdir -p \"$1\" && cd \"$1\" && exec \"$2\" \"$3\" -r CONFIG+=release CONFIG-=debug", "--", "${workspaceFolder}/build/linux-release", "/home/ww/Qt/5.15.2/gcc_64/bin/qmake", "${workspaceFolder}/GxApps.pro"]
			},
			"windows": {
				"command": "powershell.exe",
				"args": ["-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $root = (Get-Location).ProviderPath; $dir = Join-Path $root 'build/windows-release'; New-Item -ItemType Directory -Path $dir -Force | Out-Null; Set-Location -LiteralPath $dir; & 'C:/Qt/5.15.2/mingw81_64/bin/qmake.exe' (Join-Path $root 'GxApps.pro') '-r' 'CONFIG+=release' 'CONFIG-=debug'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }"],
				"options": {
					"cwd": "${workspaceFolder}",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"problemMatcher": []
		},
		{
			"label": "qmake Debug",
			"type": "process",
			"command": "/home/ww/Qt/5.15.2/gcc_64/bin/qmake",
			"args": ["GxApps.pro", "-r", "CONFIG+=debug"],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"PATH": "/home/ww/Qt/5.15.2/gcc_64/bin:${env:PATH}",
					"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}"
				}
			},
			"linux": {
				"command": "bash",
				"args": ["-c", "mkdir -p \"$1\" && cd \"$1\" && exec \"$2\" \"$3\" -r CONFIG+=debug CONFIG-=release", "--", "${workspaceFolder}/build/linux-debug", "/home/ww/Qt/5.15.2/gcc_64/bin/qmake", "${workspaceFolder}/GxApps.pro"]
			},
			"windows": {
				"command": "powershell.exe",
				"args": ["-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $root = (Get-Location).ProviderPath; $dir = Join-Path $root 'build/windows-debug'; New-Item -ItemType Directory -Path $dir -Force | Out-Null; Set-Location -LiteralPath $dir; & 'C:/Qt/5.15.2/mingw81_64/bin/qmake.exe' (Join-Path $root 'GxApps.pro') '-r' 'CONFIG+=debug' 'CONFIG-=release'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }"],
				"options": {
					"cwd": "${workspaceFolder}",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"problemMatcher": []
		},
		{
			"label": "Build Debug",
			"type": "process",
			"command": "make",
			"args": ["-j8"],
			"options": {"cwd": "${workspaceFolder}"},
			"linux": {
				"options": {
					"cwd": "${workspaceFolder}/build/linux-debug",
					"env": {
						"PATH": "/home/ww/Qt/5.15.2/gcc_64/bin:${env:PATH}",
						"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}"
					}
				}
			},
			"windows": {
				"command": "C:/Qt/Tools/mingw810_64/bin/mingw32-make.exe",
				"options": {
					"cwd": "${workspaceFolder}/build/windows-debug",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"dependsOn": "qmake Debug",
			"dependsOrder": "sequence",
			"problemMatcher": "$gcc"
		},
		{
			"label": "Build all",
			"type": "process",
			"command": "make",
			"args": ["-j8"],
			"options": {"cwd": "${workspaceFolder}"},
			"linux": {
				"options": {
					"cwd": "${workspaceFolder}/build/linux-release",
					"env": {
						"PATH": "/home/ww/Qt/5.15.2/gcc_64/bin:${env:PATH}",
						"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}"
					}
				}
			},
			"windows": {
				"command": "C:/Qt/Tools/mingw810_64/bin/mingw32-make.exe",
				"options": {
					"cwd": "${workspaceFolder}/build/windows-release",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"dependsOn": "qmake",
			"dependsOrder": "sequence",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "Clean build outputs",
			"type": "process",
			"command": "bash",
			"args": [
				"-c",
				"rm -rf -- build/linux-debug build/linux-release build/linux-package-release build/docker-release build/windows-debug build/windows-release"
			],
			"options": {"cwd": "${workspaceFolder}"},
			"windows": {
				"command": "powershell.exe",
				"args": [
					"-NoProfile",
					"-Command",
					"$ErrorActionPreference = 'Stop'; foreach ($name in @('linux-debug','linux-release','linux-package-release','docker-release','windows-debug','windows-release')) { $path = Join-Path 'build' $name; if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Recurse -Force } }"
				]
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "Run SeiSeeMp",
			"type": "process",
			"command": "${workspaceFolder}/build/linux-release/SeiSeeMp/SeiSeeMp",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}",
					"QT_PLUGIN_PATH": "/home/ww/Qt/5.15.2/gcc_64/plugins",
					"QT_QPA_PLATFORM_PLUGIN_PATH": "/home/ww/Qt/5.15.2/gcc_64/plugins/platforms"
				}
			},
			"windows": {
				"command": "${workspaceFolder}/build/windows-release/SeiSeeMp/release/SeiSeeMp.exe",
				"options": {
					"cwd": "${workspaceFolder}",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"dependsOn": "Build all",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Run SeiSeeMp (no build)",
			"type": "process",
			"command": "${workspaceFolder}/build/linux-release/SeiSeeMp/SeiSeeMp",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}",
					"QT_PLUGIN_PATH": "/home/ww/Qt/5.15.2/gcc_64/plugins",
					"QT_QPA_PLATFORM_PLUGIN_PATH": "/home/ww/Qt/5.15.2/gcc_64/plugins/platforms"
				}
			},
			"windows": {
				"command": "${workspaceFolder}/build/windows-release/SeiSeeMp/release/SeiSeeMp.exe",
				"options": {
					"cwd": "${workspaceFolder}",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"problemMatcher": []
		},
		{
			"label": "Clear SeiSeeMp settings",
			"type": "process",
			"command": "bash",
			"args": [
				"-lc",
				"settings_file=\"${XDG_CONFIG_HOME:-$HOME/.config}/WW/SeiSeeMp.conf\"; if [ -f \"$settings_file\" ]; then rm -- \"$settings_file\" && echo \"Cleared $settings_file\"; else echo \"No SeiSeeMp settings file found at $settings_file\"; fi"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"windows": {
				"command": "powershell.exe",
				"args": [
					"-NoProfile",
					"-Command",
					"$settingsKey = 'HKCU:\\Software\\WW\\SeiSeeMp'; if (Test-Path $settingsKey) { Remove-Item -Path $settingsKey -Recurse -Force -ErrorAction Stop; Write-Output 'Cleared SeiSeeMp settings from the current user registry.' } else { Write-Output 'No SeiSeeMp settings were found in the current user registry.' }"
				]
			},
			"problemMatcher": []
		},
		{
			"label": "Run SegDSeeMp",
			"type": "process",
			"command": "${workspaceFolder}/build/linux-release/SegDSeeMp/SegDSeeMp",
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}",
					"QT_PLUGIN_PATH": "/home/ww/Qt/5.15.2/gcc_64/plugins",
					"QT_QPA_PLATFORM_PLUGIN_PATH": "/home/ww/Qt/5.15.2/gcc_64/plugins/platforms"
				}
			},
			"windows": {
				"command": "${workspaceFolder}/build/windows-release/SegDSeeMp/release/SegDSeeMp.exe",
				"options": {
					"cwd": "${workspaceFolder}",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"dependsOn": "Build all",
			"dependsOrder": "sequence",
			"problemMatcher": []
		},
		{
			"label": "Open current .ui in Qt Designer",
			"type": "process",
			"command": "/home/ww/Qt/5.15.2/gcc_64/bin/designer",
			"args": ["${file}"],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"LD_LIBRARY_PATH": "/home/ww/Qt/5.15.2/gcc_64/lib:${env:LD_LIBRARY_PATH}",
					"QT_PLUGIN_PATH": "/home/ww/Qt/5.15.2/gcc_64/plugins"
				}
			},
			"windows": {
				"command": "C:/Qt/5.15.2/mingw81_64/bin/designer.exe",
				"options": {
					"cwd": "${workspaceFolder}",
					"env": {
						"PATH": "C:/Qt/5.15.2/mingw81_64/bin;C:/Qt/Tools/mingw810_64/bin;${env:PATH}"
					}
				}
			},
			"problemMatcher": []
		}
	]
}
