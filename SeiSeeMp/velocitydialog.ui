    padding: 8px 14px;
    font-weight: bold;
}
QPushButton#velocityActive:hover {
    background-color: rgba(49, 128, 226, 255);
}
QPushButton#velocityActive:pressed {
    background-color: rgba(21, 84, 166, 255);
}
QPushButton#velocityActive:checked {
    background-color: rgba(220, 107, 22, 255);
}
QPushButton#velocityActive:checked:hover {
    background-color: rgba(238, 128, 40, 255);
}
QPushButton#velocityActive:checked:pressed {
    background-color: rgba(177, 82, 13, 255);
}
QPushButton#velocityActive:disabled,
QPushButton#velocityActive:checked:disabled {
    background-color: rgba(145, 153, 163, 255);
    color: rgba(235, 237, 240, 255);
}</string>
